info func
set architecture arm
set disassemble-next-line on
catch signal SIGILL
continue
x/16wx $pc-0x40
x/20wx 0x10378
set $JT = 0x10378
x/20wx 0x10240
n
x/20wx 0x40801481
x/20wx 0x10290
set $JT = 0x10290
define dump_edge
    set $idx  = (*(unsigned short*)$pc) & 0xffff   # lower-16 bits of udf
    set $dest = *((unsigned int*)($JT + $idx*4))   # jump_table[idx]
    printf "udf #%u  →  0x%x%s\n", $idx, $dest, ($dest & 1) ? "  (Thumb)" : ""
    continue
end
 commands 1
 silent
 dump_edge
end
ignore 1 10000
set logging file edges.txt
set logging on
set logging enabled on
continue
adv
delete 1
catch signal SIGILL
commands 2
silent
dump_edge
end
q
set architecture arm
catch signal SIGILL
define dump_edge
    set $idx  = (*(unsigned short*)$pc) & 0xffff
    set $dest = *((unsigned int*)(0x10290 + $idx*4))
    printf "udf #%u -> 0x%x%s\n", $idx, $dest, ($dest & 1) ? " (Thumb)" : ""
    continue
end
commands 1
  silent
  dump_edge
end
set logging file edges.txt
set logging enabled on
set pagination off
continue
q
set architecture arm
catch signal SIGILL
define dump_edge
    set $insn = *((unsigned int*)$pc)
    set $idx  = (($insn >> 4) & 0xf0) | ($insn & 0x0f)
    set $dest = *((unsigned int*)($JT + $idx*4))
printf "udf #%3u  ->  0x%08x%s\n", $idx, $dest, ($dest & 1) ? "  (Thumb)" : ""
continue
end
delete   1
catch signal SIGILL
commands 2
silent
dump_edge
end
set logging file hello.txt
set logging enabled on
set pagination off
continue
q
define dump_edge
    set $insn = *((unsigned int*)$pc)
    set $idx  = (($insn >> 4) & 0xf0) | ($insn & 0x0f)
    set $dest = *((unsigned int*)($JT + $idx*4))
    printf "udf #%3u  ->  0x%08x%s\n", $idx, $dest, ($dest & 1) ? "  (Thumb)" : ""
    continue
end
catch signal SIGILL
commands 1
  silent
dump_edge
end
set logging file one.txt
set logging enabled on
set pagination off
continue
set $JT = 0x10290
continue
q
set architecture arm
set $JT = 0x10290
define dump_edge
    set $insn = *((unsigned int*)$pc)
    set $idx  = (($insn >> 4) & 0xf0) | ($insn & 0x0f)
    set $dest = *((unsigned int*)($JT + $idx*4))
    printf "udf #%3u  ->  0x%08x%s\n", $idx, $dest, ($dest & 1) ? "  (Thumb)" : ""
    continue
end
catch signal SIGILL
commands 1
silent
dump_edge
end
set logging file edges.txt
set logging enabled on
set pagination off
continue
